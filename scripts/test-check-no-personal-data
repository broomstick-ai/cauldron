# ---- REL-4.S7j: the REL-4.S7i-I non-blockers F1, F2, F3 --------------------
# allowall <member>: allow-list that member by the key the last run printed.
allowall() {
  local k; k=$(decodekey "$1")
  [ -n "$k" ] && allowdecode "$k" "$1" 'fixture: a deliberately corrupt stream'
}
python3 - "$HOMEPATH" <<'PY'
import sys, gzip, bz2, lzma, random
home = sys.argv[1]
bad = ("see %s\n" % home).encode(); ok = b"harmless\n" * 4
def badcrc_gz(b):
    g = bytearray(gzip.compress(b)); g[-8] ^= 0xff; return bytes(g)
def trunc_xz(b): return lzma.compress(b)[:-20]
def trunc_bz(b): return bz2.compress(b)[:-10]
# F1: a corrupt first stream, then a complete stream; and a complete stream,
# junk, then a complete stream (`gzip -dc` stops at the junk).
# xz codes a short input's literals nearly raw, so its second stream goes
# through a delta filter: the raw bytes must not already carry the value.
xz_delta = lambda b: lzma.compress(b, filters=[{"id": lzma.FILTER_DELTA, "dist": 1}, {"id": lzma.FILTER_LZMA2}])
for ext, corrupt, comp in (("gz", badcrc_gz, gzip.compress), ("xz", trunc_xz, xz_delta),
                           ("bz2", trunc_bz, bz2.compress)):
    for tag, second in (("bad", bad), ("ok", b"harmless too\n")):
        d = corrupt(ok * 20) + comp(second)
        assert home.encode() not in d
        open("multi-%s.%s" % (tag, ext), "wb").write(d)
open("junk-bad.gz", "wb").write(gzip.compress(ok) + b"JUNK" + gzip.compress(bad))
open("junk-ok.gz", "wb").write(gzip.compress(ok) + b"JUNK" + gzip.compress(b"harmless too\n"))
# F3: bzip2 with a damaged header (the first block's magic) and a block
# that is not byte-aligned holding the home path; a single-block one; a
# multi-block one with a corrupt first block; opposing: plain text that
# starts `BZh5`, and an intact two-block stream.
r = random.Random(7)
filler = "".join(r.choice("abcdefghijklmnopqrstuvwxyz \n") for _ in range(120000)).encode()
two = bz2.compress(filler + bad, 1); twook = bz2.compress(filler + ok, 1)
def nblocks(d):
    bits = bin(int.from_bytes(d, "big"))[2:].zfill(len(d) * 8)
    return bits.count(bin(0x314159265359)[2:].zfill(48))
assert nblocks(two) >= 2 and home.encode() not in two
hd = bytearray(two); hd[5] ^= 0xff; open("hdr-bad.bz2", "wb").write(bytes(hd))
one = bytearray(bz2.compress(ok)); one[5] ^= 0xff; open("hdr-one.bz2", "wb").write(bytes(one))
mid = bytearray(two); mid[2000] ^= 0xff; open("blk-bad.bz2", "wb").write(bytes(mid))
open("bzh-text.txt", "wb").write(b"BZh5 is the name of a hash in these notes\nharmless\n")
open("two-ok.bz2", "wb").write(twook)
PY

# A14 (F1) an allow-listed corrupt stream does not hide a later complete one.
for em in gz:gunzip xz:unxz bz2:bunzip2; do
  ext=${em%%:*}; m="multi-bad.$ext!${em#*:}"
  git add "multi-bad.$ext"; run
  if allowall "$m"; then
    run
    [ "$RC" = 1 ] && has "PERSONAL-DATA: $m:" && ! has "UNSCANNABLE: multi-bad.$ext" \
      && pass "A14 $ext: corrupt stream allow-listed, the later stream's home path is still caught" \
      || { fail "A14 $ext: rc=$RC (want 1, PERSONAL-DATA $m:, allow applied)"; show; }
    masked "A14 $ext"
  else fail "A14 $ext: no decode-key printed for $m"; show; fi
  reset_guard; drop "multi-bad.$ext"
  mo="multi-ok.$ext${m#multi-bad.$ext}"
  git add "multi-ok.$ext"; run
  if allowall "$mo"; then
    run
    [ "$RC" = 0 ] && pass "A14o $ext opposed: harmless after the corrupt stream, allow-listed: rc 0" \
      || { fail "A14o $ext: rc=$RC (want 0)"; show; }
  else fail "A14o $ext: no decode-key printed for $mo"; show; fi
  reset_guard; drop "multi-ok.$ext"
done
git add junk-bad.gz; run
[ "$RC" = 1 ] && has "PERSONAL-DATA: junk-bad.gz!gunzip:" \
  && pass "A14j a gzip member after junk bytes is scanned: rc 1" || { fail "A14j junk then member: rc=$RC (want 1)"; show; }
masked A14j
drop junk-bad.gz; git add junk-ok.gz; run
[ "$RC" = 0 ] && pass "A14k opposed: harmless member after junk: rc 0 (junk is not a failure)" \
  || { fail "A14k harmless junk then member: rc=$RC (want 0)"; show; }
drop junk-ok.gz

# A15 (F2) git config in the ENVIRONMENT does not change the artifact.
printf 'line one\nline two\n' > crlf.txt; git add crlf.txt; git commit -qm crlf
rm -rf "$W/fresh2"; git clone -q --no-local . "$W/fresh2"
CLEANENV="env -u GIT_CONFIG_PARAMETERS -u GIT_CONFIG_COUNT -u GIT_CONFIG_GLOBAL -u GIT_CONFIG_SYSTEM -u GIT_CONFIG -u GIT_TEMPLATE_DIR"
$CLEANENV git -C "$W/fresh2" archive --format=tar HEAD > "$W/ref.tar"
printf '[tar]\n\tumask = 0\n[core]\n\tautocrlf = true\n' > "$W/envcfg"
mkdir -p "$W/tmpl"; cp "$W/envcfg" "$W/tmpl/config"
for c in "P:GIT_CONFIG_PARAMETERS='tar.umask'='0'" "C:GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.autocrlf GIT_CONFIG_VALUE_0=true" \
         "G:GIT_CONFIG_GLOBAL=$W/envcfg" "S:GIT_CONFIG_SYSTEM=$W/envcfg" "T:GIT_TEMPLATE_DIR=$W/tmpl"; do
  tag=${c%%:*}; vars=${c#*:}
  # sentinel: the same variable DOES change a plain `git archive` (P, C, G, S),
  # or a plain `git init` + archive (T), so the comparison below can fail.
  if [ "$tag" = T ]; then
    rm -rf "$W/tbare"; $CLEANENV env $vars git init -q --bare "$W/tbare"
    printf '%s\n' "$(git rev-parse --path-format=absolute --git-path objects)" > "$W/tbare/objects/info/alternates"
    $CLEANENV git -C "$W/tbare" archive --format=tar "$(git rev-parse HEAD)" > "$W/sent.tar"
  else
    $CLEANENV env $vars git -C "$W/fresh2" archive --format=tar HEAD > "$W/sent.tar"
  fi
  cmp -s "$W/sent.tar" "$W/ref.tar" && fail "A15s $tag sentinel: the variable does not change git archive" \
    || pass "A15s $tag sentinel: the variable changes a plain git archive"
  $CLEANENV env $vars bash scripts/build-public-archive HEAD "$W/env.tar" > /dev/null || : > "$W/env.tar"
  cmp -s "$W/env.tar" "$W/ref.tar" && pass "A15 $tag: build-public-archive with it set == a fresh clone's git archive" \
    || fail "A15 $tag: the environment changed build-public-archive's bytes"
done
git rm -q -f crlf.txt; git commit -qm 'drop crlf'

