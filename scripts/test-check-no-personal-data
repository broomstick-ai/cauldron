# ---- [real] S4-S10: this repository's own files -------------------------
if (( ! REAL )); then
  skip "S4-S10 need the real pattern file (absent: public tree)"
else
  README_SRC="$HERE/../README.md"
  BYL=$(python3 - "$README_SRC" "$W/patterns" <<'PY'
import re, sys
pats = [l.rstrip("\n").split("\t")[2] for l in open(sys.argv[2]) if l.startswith("personal\t")]
for i, l in enumerate(open(sys.argv[1], encoding="utf-8"), 1):
    if any(re.search(p, l, re.I) for p in pats): print(i); break
PY
)
  [ -n "$BYL" ] && pass "S4-pre README.md has a keyed (byline) line" || fail "S4-pre README.md has no personal line (S6 would prove nothing)"
  cp "$README_SRC" README.md; printf 'see %s\n' "$HOMEPATH" >> README.md; N=$(wc -l < README.md | tr -d ' ')
  git add README.md
  run
  [ "$RC" = 1 ] && has "PERSONAL-DATA: README.md:$N:" && pass "S4 home path in README.md caught at :$N" || { fail "S4: rc=$RC (want 1)"; show; }
  cp "$README_SRC" README.md; sed -i.bak "${BYL}s|\$| $HOMEPATH|" README.md; rm -f README.md.bak; git add README.md
  run
  [ "$RC" = 1 ] && has "PERSONAL-DATA: README.md:$BYL:" && pass "S5 home path riding the byline line caught" || { fail "S5: rc=$RC (want 1)"; show; }
  cp "$README_SRC" README.md; git add README.md
  run
  [ "$RC" = 0 ] && pass "S6 opposed: README.md with the byline kept: rc 0" || { fail "S6: rc=$RC (want 0)"; show; }
  SBYL=$(sed -n "${BYL}p" README.md)
  printf '%s\n' "$SBYL" >> README.md; N=$(wc -l < README.md | tr -d ' '); git add README.md
  run
  [ "$RC" = 1 ] && has "PERSONAL-DATA: README.md:$N:" && pass "S15c a second copy of the byline is caught at :$N" || { fail "S15c: rc=$RC (want 1)"; show; }
  cp "$README_SRC" README.md; git add README.md

  # The ships/ignored oracle: check-public-tree's INTERNAL_PATHS (written
  # independently of .gitattributes and of this guard).
  INTERNAL=$(awk "/^INTERNAL_PATHS='/{f=1;next} f&&/^'/{f=0} f&&NF" "$HERE/check-public-tree.sh")
  ships() { ! grep -qxF -- "$1" <<< "$INTERNAL"; }
  REPO_SRC="$HERE/.."
  FORMER=(
    BUILDING.md R3.S2.0.hub-inspect.md R3.S2.0.hub-report.md apps/tui/HANDOFF.md
    cli/src/launchd.rs cli/src/jobs.rs services/soup-backup.toml
    services/threads/scripts/build-threads.sh
    docs/ACCOUNT-EMAIL-ID.md docs/ASSUMPTIONS-LOG.md docs/GAP-AUDIT.md
    docs/MESSAGING-ORCHESTRATION.md docs/PENDING-PROMISES.md
    docs/PROTOLEDGER-INTEGRATION.md docs/STRUCTURED-OUTPUT.md
    docs/THREAD-LEDGER.md docs/THREAD-LOAD-LATENCY.md
    docs/THREADS-DASHBOARD-REVIEW.md docs/TUI-SUBAGENTS.md
    docs/build-target-size.md docs/runbook-r5s3-hosts-all.md
    libs/env/tests/hosts_all.rs apps/tui/tests/it/designs_165.rs
    apps/tui/tests/it/light_global_0205.rs apps/tui/tests/it/review_165.rs
    NOTICE libs/soup/src/scrub.rs libs/soup/tests/it/scrub.rs
    scripts/install_conformance_test.sh
    scripts/check-no-personal-data.sh
  )
  ORIG="$W/orig"; mkdir -p "$ORIG"
  cp "$REPO_SRC/.gitattributes" .gitattributes; git add .gitattributes
  nships=0; nign=0
  for f in "${FORMER[@]}"; do
    [ "$f" = scripts/check-no-personal-data.sh ] && src="$W/guard.orig" || src="$REPO_SRC/$f"
    if [ ! -f "$src" ]; then fail "S7-pre $f missing from the source repo"; continue; fi
    mkdir -p "$(dirname "$f")" "$ORIG/$(dirname "$f")"
    cp "$src" "$f"; cp "$src" "$ORIG/$f"; git add "$f"
    if ships "$f"; then nships=$((nships + 1)); else nign=$((nign + 1)); fi
  done
  [ "$nships" -gt 0 ] && [ "$nign" -gt 0 ] && pass "S7-pre both regimes populated: $nships ship, $nign export-ignored" \
    || fail "S7-pre a regime is empty ($nships ship, $nign ignored)"
  run
  [ "$RC" = 0 ] && pass "S7 rc=0 on all ${#FORMER[@]} former whole-file exemptions as they stand" \
    || { fail "S7 rc=$RC on the former exemptions as they stand (want 0)"; show; }
  for f in "${FORMER[@]}"; do
    [ -f "$ORIG/$f" ] || continue
    if ships "$f"; then want=1; tag=ships; else want=0; tag="export-ignored, not in the artifact"; fi
    # S8
    printf '\nsee %s\n' "$HOMEPATH" >> "$f"; N=$(wc -l < "$f" | tr -d ' '); git add "$f"
    run
    if [ "$RC" = "$want" ] && { [ "$want" = 0 ] || has "PERSONAL-DATA: $f:$N:"; }; then pass "S8 $f ($tag): home path rc $want"
    else fail "S8 $f ($tag): rc=$RC (want $want)"; show | tail -n 3; fi
    cp "$ORIG/$f" "$f"
    # S9 — a secret fails ANYWHERE in the tree, shipped or not.
    printf '\ntoken = "%s"\n' "$CANARY" >> "$f"; N=$(wc -l < "$f" | tr -d ' '); git add "$f"
    run
    case "$OUT" in *"$TAIL"*) fail "S9 $f: THE GUARD PRINTED THE SECRET'S VALUE" ;; esac
    if [ "$RC" = 1 ] && has "SECRET-SHAPED: $f"; then pass "S9 $f: secret caught"
    else fail "S9 $f: rc=$RC (want 1)"; fi
    cp "$ORIG/$f" "$f"; git add "$f"
    # S10 — a home path appended to the first personal line.
    L=$(python3 - "$f" "$W/patterns" <<'PY'
import re, sys
pats = [l.rstrip("\n").split("\t")[2] for l in open(sys.argv[2]) if l.startswith("personal\t")]
for i, l in enumerate(open(sys.argv[1], "rb"), 1):
    if any(re.search(p, l.decode("latin-1"), re.I) for p in pats): print(i); break
PY
)
    if [ -n "$L" ]; then
      sed -i.bak "${L}s|\$| $HOMEPATH|" "$f"; rm -f "$f.bak"; git add "$f"
      run
      if [ "$RC" = "$want" ] && { [ "$want" = 0 ] || has "PERSONAL-DATA: $f:$L:"; }; then pass "S10 $f ($tag): home path on personal line :$L rc $want"
      else fail "S10 $f ($tag): rc=$RC on :$L (want $want)"; fi
      cp "$ORIG/$f" "$f"; git add "$f"
    fi
  done
  run
  [ "$RC" = 0 ] && pass "S7-post restored tree rc=0" || { fail "S7-post restored tree rc=$RC (want 0)"; show; }
fi

if [ "$FAILS" -ne 0 ]; then
  echo "test-check-no-personal-data: $FAILS FAILED"
  finish 1
fi
echo "test-check-no-personal-data: all cases held"
finish 0
