#!/usr/bin/env bash
# test-check-no-personal-data — conformance test for scripts/check-no-personal-data.sh
#
#   scripts/test-check-no-personal-data [SCRIPT_UNDER_TEST [BUILDER_UNDER_TEST]]
#
# BUILDER_UNDER_TEST (default scripts/build-public-archive) is the archive
# builder copied beside the guard; pass an older one to force A13 red.
#
# Runs a copy of the guard inside SCRATCH git repos (nothing in this repo is
# planted or staged). Since REL-4.S7h the guard scans the `git archive`
# artifact (scripts/build-public-archive), so every case below is a case
# against the ARCHIVE path.
#
# The planted personal values are the `sample` lines of
# scripts/personal-patterns.private (export-ignored, never shipped). This file
# therefore carries no personal literal at all. Where that file is absent:
#   - in a tree with export-ignored paths (the operator's) this test FAILS;
#   - in a public tree it runs every mechanism case against a SYNTHETIC
#     pattern file, and SKIPs (says so) the cases that need the real lines.
# Secret canaries are generated at run time and never printed.
#
#   S1-S3   a secret-shaped canary caught, its value unprinted; opposed.
#   S4-S6   README.md is scanned; the byline line keyed, not the file. [real]
#   S7-S10  every former whole-file exemption as it stands: rc 0; then per
#           file a home path, a secret, a home path riding a keyed line:
#           rc 1 if the file SHIPS, rc 0 if it is export-ignored (it is not
#           in the artifact). The ships/ignored oracle is check-public-tree's
#           own INTERNAL_PATHS list, not the guard's reading. [real]
#   S11-S13 NUL-byte file, `binary` attribute, symlink target (REL-4.S7ef-I B2).
#   S14     a real-shaped key beside the word FAKE.
#   S15     an exact second copy of a keyed line (keys count occurrences).
#   S16     a git subcommand that errors (grep, archive): rc 2, never clean.
#   S17     a line committed then removed from worktree+index: caught in HEAD.
#   S18     no planted personal value appears in any output (every pattern).
#   REL-4.S7h, each paired with an opposing harmless case:
#   A1  (REL-4.S7g-I B1) personal data in a DIRECTORY name and a FILE name.
#   A2  (REL-4.S7g-I B2) `export-subst` + `$Format:%ae$` with a personal
#       author email: the attribute is refused; with the path allow-listed
#       the EXPANDED content is still caught (the source blob has no hit, so
#       only the archive can show it); an export-ignored .gitattributes is
#       still seen.
#   A3  (REL-4.S7g-I N1) UTF-16LE with BOM, UTF-16BE without, UTF-32LE.
#   A4  (REL-4.S7g-I N1) gzip, zip (content and member name), tar.gz.
#   A5  (REL-4.S7g-I N2) a keyed line moved into a file named `<file>|<head>`.
#   A6  (REL-4.S7ef-I B1) a keyed HOME PATH in a shipped file: never exempt.
#   A7  NFKC: the name in fullwidth letters, and split by a zero-width joiner.
#   A8  two index entries differing only by case (lost by extraction on APFS).
#   A9  the pattern file missing from a private tree: rc 2; a sample that does
#       not match: rc 2.
#   A10 (N3) the guard under test carries no personal literal.
#   REL-4.S7i (REL-4.S7h-I N1-N3), each with its opposing case:
#   A11 (N1) bad-CRC gzip, bad-check xz, truncated bz2, bad-CRC zip: the
#       recovered content is caught AND the member fails closed; a harmless
#       bad-CRC gzip fails closed; allow-listed by key+reason it passes; no
#       reason: rc 2; the key binds the bytes.
#   A12 (N2) gzip, bz2, xz, zlib, tar nested 10 deep: refused; 5 deep with a
#       home path: caught by the scan; 7 deep harmless: rc 0.
#   A13 (N3) a file export-ignored only by .git/info/attributes,
#       core.attributesFile or the global attributes file: still caught;
#       the builder's bytes equal a fresh clone's `git archive`; opposed: a
#       COMMITTED export-ignore keeps it out (rc 0).
#   REL-4.S7j (REL-4.S7i-I F1-F3), each with its opposing case:
#   A14 (F1) gzip, xz, bz2: a corrupt first stream ALLOW-LISTED, then a
#       complete stream holding a home path: still caught; harmless: rc 0.
#       A gzip member after junk bytes is scanned; harmless: rc 0.
#   A15 (F2) GIT_CONFIG_PARAMETERS, GIT_CONFIG_COUNT/KEY/VALUE,
#       GIT_CONFIG_GLOBAL, GIT_CONFIG_SYSTEM, GIT_TEMPLATE_DIR: each changes a
#       plain `git archive` (sentinel) and none changes build-public-archive's
#       bytes (== a fresh clone's archive).
#   A16 (F3) bz2 with a damaged block magic: fails closed, its intact later
#       block is recovered and caught, also behind an allow entry; a corrupt
#       first block: the second is caught; opposed: text starting `BZh5` and
#       an intact two-block bz2: rc 0.
#
# Exits 0 only if every case held.
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
SCRIPT=${1:-$HERE/check-no-personal-data.sh}
BUILDER=${2:-$HERE/build-public-archive}
W=$(mktemp -d "${TMPDIR:-/tmp}/test-check-no-personal-data.XXXXXX")
# bash 3.2 exits 0 from a `set -u` abort when an EXIT trap is set: anything
# but a deliberate `finish` is a failure of this test, never a pass.
FINISHED=
finish() { FINISHED=1; exit "$1"; }
trap 'st=$?; rm -rf "$W"; if [ -z "$FINISHED" ]; then echo "test-check-no-personal-data: ABORTED (status $st)"; exit 1; fi' EXIT

FAILS=0
pass() { echo "[PASS] $1"; }
fail() { echo "[FAIL] $1"; FAILS=$((FAILS + 1)); }
skip() { echo "[SKIP] $1"; }

# ---- the pattern file ----------------------------------------------------
SRC_PATTERNS="$HERE/personal-patterns.private"
src_private=0
if git -C "$HERE/.." ls-files -z | git -C "$HERE/.." check-attr -z --stdin export-ignore \
    | tr '\0' '\n' | paste - - - | awk -F'\t' '$3=="set"{f=1} END{exit !f}'; then src_private=1; fi
REAL=0
if [ -f "$SRC_PATTERNS" ]; then
  REAL=1; cp "$SRC_PATTERNS" "$W/patterns"
elif (( src_private )); then
  fail "PRE scripts/personal-patterns.private is missing from a private tree"
  echo "test-check-no-personal-data: 1 FAILED"; finish 1
else
  skip "PRE no personal-pattern file (public tree): synthetic patterns; [real] cases skipped"
  printf 'personal\thome\t/Users/zqxop\npersonal\tname\tzqxop\npersonal\temail\t[A-Za-z0-9._%%+-]+@zqx-mail\\.example\n' > "$W/patterns"
  printf 'sample\thome\t/Users/zqxop/fake-home/notes.txt\nsample\tname\tzqxop-canary\nsample\temail\tsomeone@zqx-mail.example\n' >> "$W/patterns"
fi
sample() { awk -F'\t' -v k="$1" '$1=="sample" && $2==k {print $3; exit}' "$W/patterns"; }
HOMEPATH=$(sample home); NAMEV=$(sample name); EMAILV=$(sample email)
[ -n "$HOMEPATH" ] && [ -n "$NAMEV" ] && [ -n "$EMAILV" ] \
  && pass "PRE samples for home, name and email are present" \
  || { fail "PRE a sample is missing (home/name/email)"; finish 1; }
# pmatch: rc 0 iff stdin matches any personal pattern (case-insensitive).
pmatch() {
  python3 -c '
import re, sys
pats = [l.rstrip("\n").split("\t")[2] for l in open(sys.argv[1]) if l.startswith("personal\t")]
d = sys.stdin.buffer.read().decode("utf-8", "replace")
sys.exit(0 if any(re.search(p, d, re.I) for p in pats) else 1)' "$W/patterns"
}
printf '%s' "$NAMEV" | pmatch && printf '%s' "$HOMEPATH" | pmatch && printf '%s' "$EMAILV" | pmatch \
  && pass "PRE pmatch finds every sample (positive sentinel)" || fail "PRE pmatch cannot find a sample"
printf 'nothing personal here' | pmatch && fail "PRE pmatch matches a harmless string" || pass "PRE pmatch rejects a harmless string"

# ---- scratch repo --------------------------------------------------------
mkdir -p "$W/repo/scripts"
cp "$SCRIPT" "$W/guard.orig"
cp "$W/guard.orig" "$W/repo/scripts/check-no-personal-data.sh"
cp "$BUILDER" "$W/repo/scripts/build-public-archive"
cp "$W/patterns" "$W/repo/scripts/personal-patterns.private"   # untracked: never in the archive
cd "$W/repo"
git init -q; git config user.email proof@localhost; git config user.name proof
git add scripts/check-no-personal-data.sh scripts/build-public-archive; git commit -qm base

TAIL=$(openssl rand -hex 24)
P1=sk; P2=ant
CANARY="$P1-$P2-api03-$TAIL"

run() { set +e; OUT=$(bash scripts/check-no-personal-data.sh 2>&1); RC=$?; set -e; }
show() { printf '%s\n' "$OUT" | sed "s/$TAIL/<CANARY-TAIL>/g" | sed 's/^/    /'; }
# No pipe (REL-4.S7j): under pipefail a `printf | grep -q` can report the
# writer's SIGPIPE instead of grep's match, and `! has X` would then pass
# with X present. A here-string has no writer to lose.
has() { grep -qF -- "$1" <<< "$OUT"; }
# S18: nothing the guard prints matches ANY personal pattern.
masked() {
  if printf '%s' "$OUT" | pmatch; then fail "S18 $1: THE GUARD PRINTED A PERSONAL VALUE"
  else pass "S18 $1: no personal value in the output"; fi
}
drop() { for p in "$@"; do git rm -rq --cached -f --ignore-unmatch -- "$p"; rm -rf -- "$p"; done; }
reset_guard() { cp "$W/guard.orig" scripts/check-no-personal-data.sh; }
# addkey <path> <line>: key that exact line in the guard under test, in BOTH
# the REL-4.S7h format sha256(path NUL line) and the older sha256(path|line),
# so a case measures the same exemption against either guard.
addkey() {
  python3 - "$1" "$2" <<'PY'
import hashlib, sys
p, l = sys.argv[1].encode(), sys.argv[2].encode()
keys = [hashlib.sha256(p + b"\0" + l).hexdigest(), hashlib.sha256(p + b"|" + l).hexdigest()]
g = "scripts/check-no-personal-data.sh"
s = open(g).read()
anchor = "\nLINE_KEYS='\n"
assert anchor in s, "no LINE_KEYS anchor"
s = s.replace(anchor, anchor + "".join("%s %s\n" % (k, sys.argv[1]) for k in keys), 1)
open(g, "w").write(s)
PY
}

# S1 / S2
printf 'token = "%s"\n' "$CANARY" > planted.txt
git add planted.txt
run; show
[ "$RC" = 1 ] && pass "S1a rc=1 on a planted secret" || fail "S1a rc=$RC on a planted secret (want 1)"
has 'SECRET-SHAPED: planted.txt:1: <redacted kind=anthropic-api-key>' \
  && pass "S1b named by file:line and kind" || fail "S1b not named by file:line and kind"
case "$OUT" in *"$TAIL"*) fail "S2a THE GUARD PRINTED THE SECRET'S VALUE" ;; *) pass "S2a the secret's value is not in the output" ;; esac
case "$OUT" in
  *"${TAIL:0:12}"*|*"${TAIL:12:12}"*|*"${TAIL:24:12}"*|*"${TAIL:36:12}"*) fail "S2b a 12-char piece of the secret's tail is in the output" ;;
  *) pass "S2b no 12-char piece of it either" ;;
esac
# S3
drop planted.txt
printf 'token = "not a secret"\n' > planted.txt; git add planted.txt
run
[ "$RC" = 0 ] && pass "S3 rc=0 on a harmless line" || { fail "S3 rc=$RC on a harmless line (want 0)"; show; }
drop planted.txt

# ---- REL-4.S7h archive cases -------------------------------------------
# A1 — names. The content is harmless; only the PATH carries the value.
mkdir -p "docs/$NAMEV"; printf 'harmless\n' > "docs/$NAMEV/readme.txt"; git add "docs/$NAMEV/readme.txt"
run; show
[ "$RC" = 1 ] && has "PERSONAL-DATA: docs/<personal>" && has "/readme.txt: path" \
  && pass "A1a a DIRECTORY name carrying the value is caught" || fail "A1a directory name: rc=$RC (want 1, path named)"
masked A1a
drop docs
printf 'harmless\n' > "notes-$NAMEV.txt"; git add "notes-$NAMEV.txt"
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: notes-<personal>" && has ".txt: path" \
  && pass "A1b a FILE name carrying the value is caught" || fail "A1b file name: rc=$RC (want 1)"
drop "notes-$NAMEV.txt"
mkdir -p docs/plain; printf 'harmless\n' > docs/plain/readme.txt; git add docs/plain/readme.txt
run
[ "$RC" = 0 ] && pass "A1c opposed: harmless names: rc 0" || { fail "A1c harmless names: rc=$RC (want 0)"; show; }
drop docs

# A2 — export-subst: the leak exists only in the ARCHIVE, made from commit
# metadata at archive time.
printf 'built by $Format:%%ae$\n' > zz-subst.txt
printf '/zz-subst.txt export-subst\n' > .gitattributes
git add zz-subst.txt .gitattributes
git -c user.email="$EMAILV" commit -qm subst
if git show HEAD:zz-subst.txt | pmatch; then fail "A2-pre the SOURCE blob already matches (A2 would prove nothing)"
else pass "A2-pre the source blob has no personal match"; fi
if git archive HEAD zz-subst.txt | tar -xOf - zz-subst.txt | pmatch; then pass "A2-pre the ARCHIVE expands it to a personal value"
else fail "A2-pre the archive does not expand to a personal value (A2 would prove nothing)"; fi
run; show
[ "$RC" = 1 ] && has "EXPORT-SUBST: zz-subst.txt" \
  && pass "A2a export-subst is refused" || fail "A2a export-subst: rc=$RC (want 1, EXPORT-SUBST named)"
masked A2a
# A2b — allow-list the path, so only the content scan can fire.
python3 - <<'PY'
g = "scripts/check-no-personal-data.sh"; s = open(g).read()
a = "\nEXPORT_SUBST_ALLOW='\n"
s = s.replace(a, a + "zz-subst.txt\n", 1) if a in s else s
open(g, "w").write(s)
PY
run; show
[ "$RC" = 1 ] && has "PERSONAL-DATA: zz-subst.txt:1:" && ! has "EXPORT-SUBST" \
  && pass "A2b allow-listed: the EXPANDED email is caught by the content scan" || fail "A2b expanded content: rc=$RC (want 1, zz-subst.txt:1, no EXPORT-SUBST)"
masked A2b
git commit -q --allow-empty -m 'harmless author'   # proof@localhost
run
[ "$RC" = 0 ] && pass "A2c opposed: allow-listed, harmless author: rc 0" || { fail "A2c allow-listed, harmless author: rc=$RC (want 0)"; show; }
reset_guard
# A2d — the .gitattributes that sets it is itself export-ignored.
printf '/zz-subst.txt export-subst\n.gitattributes export-ignore\n' > .gitattributes; git add .gitattributes; git commit -qm hidden-attr
run
[ "$RC" = 1 ] && has "EXPORT-SUBST: zz-subst.txt has the export-subst attribute" \
  && pass "A2d an export-ignored .gitattributes still cannot hide export-subst" || { fail "A2d hidden attribute: rc=$RC (want 1)"; show; }
git rm -q zz-subst.txt .gitattributes; git commit -qm rm-subst
run
[ "$RC" = 0 ] && pass "A2e opposed: export-subst gone: rc 0" || { fail "A2e after removal: rc=$RC (want 0)"; show; }

# A3 — UTF-16 / UTF-32.
u16() { python3 -c 'import sys; sys.stdout.buffer.write(sys.argv[2].encode(sys.argv[1]))' "$1" "$2"; }
{ printf '\xff\xfe'; u16 utf-16-le "see $HOMEPATH"; } > utf16le.txt; git add utf16le.txt
run; show
[ "$RC" = 1 ] && has "PERSONAL-DATA: utf16le.txt#utf-16-le" && pass "A3a UTF-16LE (BOM) caught" || fail "A3a UTF-16LE: rc=$RC (want 1)"
masked A3a
drop utf16le.txt
u16 utf-16-be "see $HOMEPATH" > utf16be.txt; git add utf16be.txt
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: utf16be.txt#utf-16-be" && pass "A3b UTF-16BE (no BOM) caught" || { fail "A3b UTF-16BE: rc=$RC (want 1)"; show; }
drop utf16be.txt
u16 utf-32-le "see $HOMEPATH" > utf32.txt; git add utf32.txt
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: utf32.txt#utf-32-le" && pass "A3c UTF-32LE caught" || { fail "A3c UTF-32LE: rc=$RC (want 1)"; show; }
drop utf32.txt
{ printf '\xff\xfe'; u16 utf-16-le "see nothing personal"; } > utf16ok.txt; git add utf16ok.txt
run
[ "$RC" = 0 ] && pass "A3d opposed: harmless UTF-16: rc 0" || { fail "A3d harmless UTF-16: rc=$RC (want 0)"; show; }
drop utf16ok.txt

# A4 — compressed and container members.
printf 'see %s\n' "$HOMEPATH" | gzip -c > blob.gz; git add blob.gz
run; show
[ "$RC" = 1 ] && has "PERSONAL-DATA: blob.gz!gunzip:1:" && pass "A4a gzip caught" || fail "A4a gzip: rc=$RC (want 1)"
masked A4a
drop blob.gz
python3 - "$HOMEPATH" "$NAMEV" <<'PY'
import io, sys, tarfile, zipfile, gzip
home, name = sys.argv[1], sys.argv[2]
with zipfile.ZipFile("content.zip", "w", zipfile.ZIP_DEFLATED) as z: z.writestr("inner/notes.txt", "see %s\n" % home)
with zipfile.ZipFile("named.zip", "w", zipfile.ZIP_DEFLATED) as z: z.writestr("inner/%s.txt" % name, "harmless\n")
b = io.BytesIO()
with tarfile.open(fileobj=b, mode="w") as t:
    data = ("see %s\n" % home).encode(); ti = tarfile.TarInfo("deep/notes.txt"); ti.size = len(data)
    t.addfile(ti, io.BytesIO(data))
open("nested.tar.gz", "wb").write(gzip.compress(b.getvalue()))
with zipfile.ZipFile("ok.zip", "w", zipfile.ZIP_DEFLATED) as z: z.writestr("inner/notes.txt", "harmless\n")
PY
git add content.zip
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: content.zip!inner/notes.txt:1:" && pass "A4b zip member content caught" || { fail "A4b zip content: rc=$RC (want 1)"; show; }
drop content.zip; git add named.zip
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: named.zip!inner/<personal>" && has ".txt: path" && pass "A4c zip member NAME caught" || { fail "A4c zip member name: rc=$RC (want 1)"; show; }
drop named.zip; git add nested.tar.gz
run
[ "$RC" = 1 ] && has "PERSONAL-DATA: nested.tar.gz!gunzip!deep/notes.txt:1:" && pass "A4d tar inside gzip caught" || { fail "A4d tar.gz: rc=$RC (want 1)"; show; }
drop nested.tar.gz; git add ok.zip
printf 'harmless\n' | gzip -c > ok.gz; git add ok.gz
run
[ "$RC" = 0 ] && pass "A4e opposed: harmless zip and gzip: rc 0" || { fail "A4e harmless archives: rc=$RC (want 0)"; show; }
drop ok.zip ok.gz

# ---- REL-4.S7i: the guard's last three holes (REL-4.S7h-I N1, N2, N3) ----
# allowdecode <key> <member> <reason>: add a DECODE_ALLOW entry to the guard
# under test. A guard with no DECODE_ALLOW list cannot take one: rc 3.
allowdecode() {
  python3 - "$1" "$2" "$3" <<'PY'
import sys
g = "scripts/check-no-personal-data.sh"
s = open(g).read()
anchor = "\nDECODE_ALLOW='\n"
if anchor not in s: sys.exit(3)
s = s.replace(anchor, anchor + "%s\t%s\t%s\n" % tuple(sys.argv[1:4]), 1)
open(g, "w").write(s)
PY
}
decodekey() { printf '%s' "$OUT" | sed -n "s/.*UNSCANNABLE: $1: does not fully decode.*\[decode-key \([0-9a-f]\{64\}\)\].*/\1/p" | awk 'NR == 1'; }   # awk reads to the end: no SIGPIPE under pipefail

# A11 (N1) a corrupt checksum or a truncated stream: what decodes is scanned,
# and the member fails closed unless allow-listed, by key, with a reason.
python3 - "$HOMEPATH" <<'PY'
import sys, gzip, bz2, lzma, zipfile, io
home = sys.argv[1]
bad = ("see %s\n" % home).encode(); ok = b"harmless\n" * 4
def badcrc_gz(b):
    g = bytearray(gzip.compress(b)); g[-8] ^= 0xff; return bytes(g)
def badcheck_xz(b):
    x = bytearray(lzma.compress(b, check=lzma.CHECK_CRC64))
    # the CRC64 sits after the block's compressed data: flip bytes until the
    # stream decodes in full and only the check fails
    for i in range(12, len(x) - 12):
        y = bytearray(x); y[i] ^= 1; d = lzma.LZMADecompressor(); out = b""
        try:
            out = d.decompress(bytes(y[:i])); d.decompress(bytes(y[i:]))
        except lzma.LZMAError as e:
            if out == b and "Corrupt" in str(e): return bytes(y)
    raise SystemExit("no check byte found")
open("badcrc.gz", "wb").write(badcrc_gz(bad))
open("okcrc.gz", "wb").write(badcrc_gz(ok))
open("badcheck.xz", "wb").write(badcheck_xz(bad))
open("trunc.bz2", "wb").write(bz2.compress(bad * 50)[:-10])
z = io.BytesIO()
with zipfile.ZipFile(z, "w", zipfile.ZIP_STORED) as zf: zf.writestr("inner/notes.txt", bad)
zb = bytearray(z.getvalue()); i = zb.find(b"PK\x01\x02") + 16; zb[i] ^= 0xff   # central-directory CRC
open("badcrc.zip", "wb").write(bytes(zb))
PY
for f in badcrc.gz:'!gunzip' badcheck.xz:'!unxz' trunc.bz2:'!bunzip2' badcrc.zip:'!inner/notes.txt'; do
  file=${f%%:*}; m=${f#*:}
  git add "$file"; run
  if [ "$RC" = 1 ] && has "PERSONAL-DATA: $file$m:1:" && has "UNSCANNABLE: $file"; then
    pass "A11 $file: the recovered content is caught AND the member fails closed"
  else fail "A11 $file: rc=$RC (want 1, PERSONAL-DATA $file$m:1: and UNSCANNABLE)"; show; fi
  masked "A11 $file"
  drop "$file"
done
git add okcrc.gz; run
[ "$RC" = 1 ] && has "UNSCANNABLE: okcrc.gz!gunzip: does not fully decode" \
  && pass "A11o a harmless gzip with a bad CRC still fails closed: rc 1" \
  || { fail "A11o harmless bad-CRC gzip: rc=$RC (want 1, UNSCANNABLE)"; show; }
KEY=$(decodekey 'okcrc.gz!gunzip')
if [ -n "$KEY" ] && allowdecode "$KEY" 'okcrc.gz!gunzip' 'fixture: a deliberately corrupt CRC'; then
  run
  [ "$RC" = 0 ] && pass "A11p allow-listed by key with a reason: rc 0" || { fail "A11p allow-listed okcrc.gz: rc=$RC (want 0)"; show; }
  reset_guard; allowdecode "$KEY" 'okcrc.gz!gunzip' ' '; run
  [ "$RC" = 2 ] && pass "A11q an allow entry with no reason: rc 2" || { fail "A11q allow entry without reason: rc=$RC (want 2)"; show; }
  reset_guard; printf 'harmless\n' > other.txt; git add other.txt
  python3 -c 'import gzip; g=bytearray(gzip.compress(b"harmless too\n")); g[-8]^=0xff; open("okcrc.gz","wb").write(bytes(g))'
  git add okcrc.gz; allowdecode "$KEY" 'okcrc.gz!gunzip' 'fixture: a deliberately corrupt CRC'; run
  [ "$RC" = 1 ] && has "UNSCANNABLE: okcrc.gz!gunzip" && pass "A11r the key binds the bytes: changed content, same path: rc 1" \
    || { fail "A11r stale key still exempts changed bytes: rc=$RC (want 1)"; show; }
  drop other.txt
else
  fail "A11p no decode-key printed, or the guard has no DECODE_ALLOW list"
fi
reset_guard; drop okcrc.gz

# A12 (N2) past the depth cap every container kind refuses (rc 1); at a legal
# depth the same nesting is scanned (caught) or passes (harmless).
python3 - "$HOMEPATH" <<'PY'
import sys, gzip, bz2, lzma, zlib, io, tarfile
home = sys.argv[1]
def tar1(name, data):
    b = io.BytesIO()
    with tarfile.open(fileobj=b, mode="w", format=tarfile.USTAR_FORMAT) as t:
        ti = tarfile.TarInfo(name); ti.size = len(data); t.addfile(ti, io.BytesIO(data))
    return b.getvalue()
wrap = {"gz": gzip.compress, "bz2": bz2.compress, "xz": lzma.compress,
        "zlib": zlib.compress, "tar": lambda d: tar1("x", d)}
for k, f in wrap.items():
    for n, body in ((10, "harmless\n"), (5, "see %s\n" % home), (7, "harmless\n")):
        d = body.encode()
        for _ in range(n): d = f(d)
        open("deep%d.%s" % (n, k), "wb").write(d)
PY
for k in gz bz2 xz zlib tar; do
