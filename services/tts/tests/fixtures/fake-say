#!/bin/bash
# Stand-in for macOS `say`. Every test in this crate points TTS_SAY_BIN here,
# so nothing a test does reaches the operator's speech service.
#
# It accepts exactly the argv the `system` module builds,
#     say -o <out>.part.aiff -v <voice> -- <text>
# and FAILS, as `say` does, on any option or bare word before `--` — which is
# how dropping the `--` from the module is caught.
#
# Behaviour is controlled by files under <data_dir>/.fakesay/, where <data_dir>
# is read off the output path (<data_dir>/audio/xx/yy/<file>). Per-test control
# needs no environment, so parallel tests cannot perturb each other.
#
#   ms      sleep this many milliseconds before writing (default 0)
#   fail    exit 1 with a message
#   signal  SIGTERM itself mid-synthesis: killed from outside, NOT a failure
#   empty   write a zero-byte output
#   bytes   payload size (default 2048)
#   live/   one file per running invocation
#   peaks   per invocation, how many were running when it started
#   calls   per invocation, the text it was given

set -u
out="" voice="" text="" ddash=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift 2 ;;
    -v) voice="$2"; shift 2 ;;
    --) ddash=1; shift; text="$*"; break ;;
    -*) echo "fake-say: invalid option $1" >&2; exit 1 ;;
    *)  echo "fake-say: bare argument before -- : $1" >&2; exit 1 ;;
  esac
done
[ "$ddash" -eq 1 ] || { echo "fake-say: no -- separator" >&2; exit 1; }
[ -n "$out" ] || { echo "fake-say: no -o" >&2; exit 1; }
[ -n "$voice" ] || { echo "fake-say: no -v" >&2; exit 1; }
case "$out" in *.aiff) ;; *) echo "fake-say: unknown format for $out" >&2; exit 1 ;; esac

# FORK-LIGHT, deliberately (R5.S1c). This used to exec about eight helper
# processes per render (dirname x2, mkdir x2, ls, wc, tr, rm, head), and under
# load fork/exec contention is what made a render slow: 36 concurrent copies
# of tests/eviction.rs measured a slowest render of 78 s. Everything below is
# a bash builtin except `rm` (no builtin unlinks), plus `sleep` and `head`
# only when a test asks for a delay or a large payload. Behaviour is unchanged.

# out = <data_dir>/audio/xx/yy/<file>. If the data dir is gone, fail; never
# fall back to $PWD.
audio_dir="${out%/*/*/*}"
[ -d "$audio_dir" ] || { echo "fake-say: data dir vanished" >&2; exit 1; }
ctl="${audio_dir%/*}/.fakesay"
[ -d "$ctl/live" ] || mkdir -p "$ctl/live"
printf '%s\n' "$text" >> "$ctl/calls"
marker="$ctl/live/$$"
: > "$marker"
shopt -s nullglob
live=("$ctl"/live/*)
printf '%s\n' "${#live[@]}" >> "$ctl/peaks"

ms=0
[ -f "$ctl/ms" ] && read -r ms < "$ctl/ms"
if [ "$ms" -gt 0 ]; then
  printf -v secs '%d.%03d' $((ms / 1000)) $((ms % 1000))
  sleep "$secs"
fi
rm -f "$marker"

if [ -f "$ctl/signal" ]; then
  # The default SIGTERM disposition kills this process, so the parent sees a
  # signalled exit — what a real `say` looks like after somebody reaps it.
  kill -TERM $$
  sleep 5
  exit 1
fi
[ -f "$ctl/fail" ] && { echo "fake-say: refused by fixture" >&2; exit 1; }
[ -d "${out%/*}" ] || mkdir -p "${out%/*}"
if [ -f "$ctl/empty" ]; then : > "$out"; exit 0; fi
size=2048
[ -f "$ctl/bytes" ] && read -r size < "$ctl/bytes"
# Not audio. Nothing in this crate decodes audio, and no test may run a codec.
# A payload up to 1 MiB is written by the builtin printf (spaces); a larger one
# falls back to head.
if [ "$size" -le 1048576 ]; then
  printf -v pad '%*s' "$size" ''
  printf '%s' "$pad" > "$out"
else
  head -c "$size" /dev/zero > "$out"
fi
