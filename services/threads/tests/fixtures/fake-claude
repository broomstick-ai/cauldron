    [[ -n "$REL" && -f "$REL" ]] && break
    sleep 0.02
  done
  if [[ "$PROMPT" == *"stderrafter"* ]]; then
    echo "fake-claude: a warning written after the handoff" >&2
  fi
  echo '{"type":"assistant","message":{"id":"msg_fake_handoff","model":"claude-fable-5","content":[{"type":"text","text":"HANDOFF TURN DONE"}],"usage":{"input_tokens":10,"output_tokens":5,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  emit_result
  exit 0
elif [[ "$PROMPT" == *"compactturn"* ]]; then
  # ── AN AUTOMATIC COMPACTION, AND THE MOMENTUM AFTER IT ──────────────────
  #
  # Three phases, in this order, because the whole subject is the boundary
  # BETWEEN them:
  #
  #   1. real work, BEFORE the compaction — it must survive whatever happens
  #      next, because the operator's rule is that nothing he or the thread
  #      produced is lost;
  #   2. the `compact_boundary` line, in the shape `stream.rs` actually parses
  #      (snake-case `compact_metadata`/`pre_tokens`, which is the spelling the
  #      real CLI emits and the one the camelCase-only reader used to miss);
  #   3. the momentum — a sleep long enough for the daemon's 150 ms tail poll
  #      to see the boundary and act, and THEN more assistant text.
  #
  # That third phase is the thing under test. `AFTER THE COMPACTION` reaching
  # the ledger means the thread kept going under its own steam; its absence
  # means the turn ended at the boundary. The sleep is what makes the two
  # outcomes distinguishable rather than a race — without it the post-compaction
  # text would already be written before any supervisor could possibly react,
  # and the test would pass for the wrong reason.
  emit_init
  emit_text
  # A window BEFORE the boundary, so a test can get a message onto the queue
  # while the turn is demonstrably mid-flight and the compaction has not
  # happened yet. Without it the boundary lands within a millisecond or two of
  # the turn starting, and a durability test that waits for `turn_started`
  # before speaking is racing — it enqueues AFTER the ending has already been
  # decided, so it cannot observe a queue being swallowed even if one is.
  sleep 0.6
  echo '{"type":"system","subtype":"compact_boundary","uuid":"cb-fake-1","compact_metadata":{"trigger":"auto","pre_tokens":150},"session_id":"fake-sess"}'
  sleep 1.5
  echo '{"type":"assistant","message":{"id":"msg_fake_post_compact","model":"claude-fable-5","content":[{"type":"text","text":"AFTER THE COMPACTION"}],"usage":{"input_tokens":10,"output_tokens":5,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  emit_result
  exit 0
elif [[ "$PROMPT" == *"compactexit"* ]]; then
  # A compaction in the LAST breath of the turn: the boundary and the result
  # are written together and the process exits at once, so the daemon reads
  # both in the same poll — the final drain after `try_wait` returns, which is
  # the one read that happens after the supervisor's teardown checks. A flag
  # raised there meets no consumer inside the loop, and if it is not drained
  # afterwards it stays raised on the THREAD and ends the next, innocent turn.
  emit_init
  emit_text
  echo '{"type":"system","subtype":"compact_boundary","uuid":"cb-fake-2","compact_metadata":{"trigger":"auto","pre_tokens":150},"session_id":"fake-sess"}'
  emit_result
  exit 0
elif [[ "$PROMPT" == *"floodturn"* ]]; then
  # More than 10,000 events, with the run's last TOP-LEVEL words near the
  # start: what a long managed child looks like when its report is read out of
  # a fixed-size tail (H179). The native-subagent lines carry
  # `parent_tool_use_id` and are NOT the child's words.
  emit_init
  echo '{"type":"assistant","message":{"id":"msg_flood_final","model":"claude-fable-5","content":[{"type":"text","text":"FLOOD-FINAL-WORDS from the long child."}],"usage":{"input_tokens":100,"output_tokens":20,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  for i in 1 2 3; do
    printf '{"type":"assistant","parent_tool_use_id":"toolu_native_1","message":{"id":"msg_native_%d","model":"claude-fable-5","content":[{"type":"text","text":"native subagent narration %d"}],"usage":{"input_tokens":1,"output_tokens":1,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}\n' "$i" "$i"
  done
  awk 'BEGIN { for (i = 1; i <= 10200; i++) printf "{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":%d,\"estimated_tokens_delta\":1,\"session_id\":\"fake-sess\",\"uuid\":\"flood-%d\"}\n", i, i }'
  emit_result
  exit 0
elif [[ "$PROMPT" == *"chattyturn"* ]]; then
  # A turn that emits MORE THAN 400 EVENTS before its result: the shape of a
  # real managed child (bd062063, 2026-10-16, 495 events in a 74 s turn), whose
  # `user_message` falls out of any fixed-size tail by the time the turn ends.
  emit_init
  for i in $(seq 1 450); do
    printf '{"type":"system","subtype":"thinking_tokens","estimated_tokens":%d,"estimated_tokens_delta":1,"session_id":"fake-sess","uuid":"chatty-%d"}\n' "$i" "$i"
  done
  emit_text
  emit_result
  exit 0
elif [[ "$PROMPT" == *"slowturn"* ]]; then
  emit_init
  emit_text
  sleep 0.7
  emit_result
  exit 0
elif [[ "$PROMPT" == *"mcpprobe"* ]]; then
  # ── THE INSTALLED CLIENT'S MCP HANDSHAKE, ON THE REAL WIRE (R4.S1) ────────
  #
  # This is NOT a mock of the daemon's door: it is the sequence the `claude`
  # 2.1.280 binary at /opt/homebrew/Caskroom/claude-code@latest/2.1.280/claude
  # performs against a streamable-HTTP MCP server, read out of the bundle
  # (`strings` over the Mach-O; the embedded @modelcontextprotocol/sdk):
  #
  #   * `Client.connect`: `request({method:"initialize",params:{protocolVersion:
  #     Sae, capabilities, clientInfo}})` with `Sae = "2025-11-25"`; the answer's
  #     `protocolVersion` must be in `zG = ["2025-11-25","2025-06-18",
  #     "2025-03-26","2024-11-05","2024-10-07"]` or it throws "Server's protocol
  #     version is not supported"; then `transport.setProtocolVersion(…)`, then
  #     `notification({method:"notifications/initialized"})`.
  #   * `StreamableHTTPClientTransport._commonHeaders`: `Authorization: Bearer
  #     <token>` from the auth provider (or the configured `headers`), and
  #     `mcp-protocol-version: <negotiated>` once set; every POST carries
  #     `Accept: application/json, text/event-stream` and
  #     `content-type: application/json`, and `mcp-session-id` once the server
  #     has answered one.
  #   * A notification is answered 202 with no body; a request is answered
  #     200 `application/json` (this door never answers `text/event-stream`).
  #
  # A probe must not witness itself: nothing here reads the daemon's code or
  # key. The token is minted by the TEST (which holds the manager) for the turn
  # this very process is, written to `tokenfile=` once the turn is running —
  # which is why this branch waits for the file rather than taking the token off
  # the prompt: the spawn cookie does not exist until the spawn has happened.
  emit_init
  emit_text
  URL="${PROMPT#*mcpurl=}";           URL="${URL%%[[:space:]]*}"
  TOKENFILE="${PROMPT#*tokenfile=}"; TOKENFILE="${TOKENFILE%%[[:space:]]*}"
  OUT="${PROMPT#*mcpout=}";          OUT="${OUT%%[[:space:]]*}"
  SELF="${PROMPT#*agentid=}";        SELF="${SELF%%[[:space:]]*}"
  for _ in $(seq 1 1000); do
    [[ -f "$TOKENFILE" ]] && break
    sleep 0.02
  done
  TOKEN="$(cat "$TOKENFILE" 2>/dev/null || true)"
  : > "$OUT"
  PV=""
  SID=""
  # One POST, exactly as the SDK's transport sends it. Records
  #   STEP <name> <http status> session=<mcp-session-id or none>
  #   BODY <name> <response body on one line>
  mcp_post() {
    local step="$1" body="$2" hdr="$OUT.$1.hdr" resp="$OUT.$1.body" code sid
    local -a extra=()
    [[ -n "$PV" ]] && extra+=(-H "mcp-protocol-version: $PV")
    [[ -n "$SID" ]] && extra+=(-H "mcp-session-id: $SID")
    code="$(curl -s -o "$resp" -D "$hdr" -w '%{http_code}' -X POST "$URL" \
      -H 'content-type: application/json' \
      -H 'accept: application/json, text/event-stream' \
      -H "authorization: Bearer $TOKEN" \
      ${extra[@]+"${extra[@]}"} \
      --data-binary "$body" 2>/dev/null || echo 000)"
    sid="$(tr -d '\r' < "$hdr" | awk -F': ' 'tolower($1)=="mcp-session-id"{print $2}' | tail -1)"
    [[ -n "$sid" ]] && SID="$sid"
    printf 'STEP %s %s session=%s\n' "$step" "$code" "${sid:-none}" >> "$OUT"
    printf 'BODY %s %s\n' "$step" "$(tr -d '\n' < "$resp" 2>/dev/null)" >> "$OUT"
  }
  mcp_post initialize '{"jsonrpc":"2.0","id":0,"method":"initialize","params":{"protocolVersion":"2025-11-25","capabilities":{},"clientInfo":{"name":"claude-code","version":"2.1.280"}}}'
  PV="$(tr -d '\n' < "$OUT.initialize.body" 2>/dev/null | sed -n 's/.*"protocolVersion":"\([^"]*\)".*/\1/p')"
  mcp_post initialized '{"jsonrpc":"2.0","method":"notifications/initialized"}'
  mcp_post ping '{"jsonrpc":"2.0","id":1,"method":"ping"}'
  mcp_post tools_list '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}'
  mcp_post call_log "{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"tools/call\",\"params\":{\"name\":\"agents_log\",\"arguments\":{\"agent\":\"$SELF\",\"limit\":50}}}"
  mcp_post call_spawn '{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"agents_spawn","arguments":{"task":"probe"}}}'
  mcp_post call_spawn_budget '{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"agents_spawn","arguments":{"task":"probe","budget_key":"k"}}}'
  emit_result
  exit 0
elif [[ "$PROMPT" == *"subagent"* ]]; then
  OUT="$STATE_DIR/threads-agent-$(printf '%s' "$PROMPT" | cksum | cut -d' ' -f1).jsonl"
  echo '{"type":"assistant","message":{"model":"claude-fable-5","content":[{"type":"text","text":"working"}]}}' > "$OUT"
  emit_init
  emit_text
  echo '{"type":"assistant","message":{"id":"msg_fake_02","model":"claude-fable-5","content":[{"type":"tool_use","id":"toolu_agent1","name":"Agent","input":{"description":"do work","subagent_type":"general-purpose","run_in_background":true,"prompt":"go"}}],"usage":{"input_tokens":5,"output_tokens":5,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
  # THE SHAPE THE REAL CLI EMITS, corrected 2026-08-12 against the capture in
  # `lib/threads/turns/`. This line used to say `toolUseResult` with a
  # `toolUseId` inside it — a shape that occurs ZERO times in 371,702 captured
  # lines. It was written to match the parser instead of the wire, and that is
  # precisely why `subagent_liveness_outlasts_parent_result` stayed green for
  # months while subagent liveness was completely dead in production. A double
  # that agrees with the code it is testing proves nothing.
  #
  # Two corrections: the envelope key is `tool_use_result` (snake), and there is
  # no `toolUseId` anywhere inside it — the id lives on the sibling
  # `tool_result` block, which is where the parser now reads it from.
  printf '{"type":"user","tool_use_result":{"isAsync":true,"status":"async_launched","agentId":"agent-abc","outputFile":"%s","canReadOutputFile":true},"message":{"content":[{"type":"tool_result","tool_use_id":"toolu_agent1","content":"launched"}]}}\n' "$OUT"
  emit_result
  exit 0
else
  emit_init; emit_text; emit_result; exit 0
fi
