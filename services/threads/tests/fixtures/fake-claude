#!/usr/bin/env bash
# Fake `claude` binary for threads WS tests (ported from CCW's fixture; NEVER a
# real invocation). The turn MODE is chosen from the prompt text on stdin so
# parallel tests never race on a shared env var:
#   prompt contains "subagent"  — an async Agent still running at parent result
#   prompt contains "ratelimit" — emits a synthetic SESSION 429 and exits. The
#                                 reset is time-only prose COMPUTED two hours
#                                 ahead of now, not a fixed clock time: a reset
#                                 that has gone by resolves to no window at all
#                                 (`reset::ResetTime::resolve`), so a literal
#                                 made every caller clock-dependent.
#   prompt contains "weeklylimit" — emits the WEEKLY 429 verbatim as the CLI
#                                 produced it on 2026-08-06, with a reset two
#                                 days out. The reset instant is COMPUTED from
#                                 today so the test is stable whenever it runs;
#                                 the shape of the prose is copied exactly.
#   prompt contains "failonce"  — first call exits 1 with a transient stderr
#                                 message; the retry succeeds (per-prompt marker)
#   prompt contains "compactturn" — work, then an automatic `compact_boundary`,
#                                 then (after a 1.5s window) MORE assistant text
#                                 reading "AFTER THE COMPACTION". Whether that
#                                 last line reaches the ledger is exactly the
#                                 `resume_after_compaction` question.
#   prompt contains "compactexit" — a compaction in the turn's LAST breath: the
#                                 boundary and the result land in one poll, so
#                                 the stop flag is raised by the final drain
#                                 and must not survive into the next turn.
#   prompt contains "slowturn"  — sleeps 0.7s mid-turn (queue-while-busy tests)
#   prompt contains "chattyturn" — 450 system lines, then text and a result: a
#                                 turn whose user_message is >400 events back
#   prompt contains "floodturn" — the child's final top-level words, then a
#                                 native subagent's narration and 10,200
#                                 system lines, then the result: a run of more
#                                 than 10,000 events whose words are far
#                                 outside any fixed tail (H179, SUBAGENT-WAKE)
#   prompt contains "holdturn"  — runs until the test creates the file named by
#                                 `release=<path>` (20s ceiling): a turn that is
#                                 DEFINITELY still executing, for the
#                                 self-update tests

#   prompt contains "netdown"   — exits 1 with a DNS-failure stderr (the network
#                                 is GONE and stays gone; item 73)
#   prompt contains "servererr" — some work, then a `server_error` API error
#                                 whose prose names ENOTFOUND (an internal thread)
#   prompt contains "netresult" — a lost network reported as an errored RESULT
#                                 on stdout (no stderr race under load)
#   prompt contains "netflap"   — exits 1 once with ECONNREFUSED, then succeeds:
#                                 the network comes back on its own
#   prompt contains "creditfail"— exits 1 with a credit-balance stderr message
#   prompt contains "schemaexhaust" / "turnsexhaust" / "okthenexit" — a result
#                                 (error_max_structured_output_retries /
#                                 error_max_turns / clean success), then exit 1
#                                 (R11.J2)
#   prompt contains "creditlate" / "genericlate" — exits 1 at once; the credit /
#                                 generic stderr line is written 500 ms LATER by
#                                 a descendant (R9.E1)
#   prompt contains "creditheld" — credit line on stderr, then a descendant holds
#                                 stderr open 20 s (pid -> `holdpid=<path>`)
#   prompt contains "limitpush" — a normal turn carrying a CURRENT-shape
#                                 rate_limit_event (`push=overage|rejected`,
#                                 optional `release=<path>` hold) — gap A-4
#   prompt contains "gaugeturn" — a normal turn PLUS the real rate_limit_event
#                                 stream line (verbatim shape from the
#                                 2026-07-27 burn-in) — the DEC-15 push gauge
#   prompt contains "bigburn"   — streams a huge MessageUsage, launches a
#                                 long-lived GRANDCHILD (pid written to the
#                                 path named by `burnfile=...` in the prompt),
#                                 then SLEEPS, so a budget kill has both a
#                                 process and a descendant to tear down
#   argv contains "/usage"      — the zero-cost usage poll (DEC-15 layer 2),
#                                 answering with CCW's observed prose shape
#   prompt contains "mcpprobe"  — performs the STREAMABLE-HTTP MCP HANDSHAKE the
#                                 installed claude 2.1.280 performs, on the real
#                                 wire, against `mcpurl=<url>` with the run token
#                                 read from `tokenfile=<path>` (waited for, 20s
#                                 ceiling), and records every step to
#                                 `mcpout=<path>`. `agentid=<thread_id>` is the
#                                 caller's own thread. See the branch for the
#                                 bundle citations.
#   argv carries `--json-schema` whose `description` holds `fake:<mode>`
#                               — STRUCTURED OUTPUT (R11.J4/J5). The answer is a
#                                 `StructuredOutput` tool_use, shaped as the J1
#                                 captures (`fixtures/structured/`) show it:
#                                 `fake:valid` answers {"verdict":"merge"} and
#                                 the result carries `structured_output`;
#                                 `fake:always-invalid` answers
#                                 {"verdict":"maybe"} and the result is
#                                 `success` with NO `structured_output` (the
#                                 CLI's "success without value"), so only the
#                                 tool_use input remains to judge;
#                                 `fake:fix-on-retry` is invalid unless the
#                                 prompt is the daemon's corrective turn ("did
#                                 not match the requested schema"). A
#                                 `hold=<path>` in the description makes the
#                                 CORRECTIVE turn wait for that file (20s
#                                 ceiling) — a retry definitely mid-flight.
#                                 `fake:fail` fails the turn (badmodel shape);
#                                 `fake:stall` holds EVERY turn on `hold=`.
#   otherwise                   — basic: system init, assistant text, result
set -u

STATE_DIR="${FAKE_STATE_DIR:-/tmp}"

# The `/usage` probe passes the slash command in ARGV with no stdin, so it must
# be answered before we block on `cat`.
for arg in "$@"; do
  if [[ "$arg" == "/usage" ]]; then
    # PROBE FAILURE (additive; nothing else changes). An account whose own
    # config dir holds a `usage-fail` file answers NOTHING at all, so the
    # probe's parse fails and `probe_account` reports the reason. Per config
    # dir for the same reason as `usage-seq` below: it is how a test makes ONE
    # account of several fail while its siblings poll cleanly, which is the
    # only shape that exercises a PARTIAL sweep failure.
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -f "${CLAUDE_CONFIG_DIR}/usage-fail" ]]; then
      exit 1
    fi
    # SLOW PROBE (R10.M2c; additive). A `usage-sleep` file in the account's
    # config dir holds seconds to sleep before answering — prod's 20-60 s
    # `/usage` spawns, made injectable.
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -f "${CLAUDE_CONFIG_DIR}/usage-sleep" ]]; then
      sleep "$(cat "${CLAUDE_CONFIG_DIR}/usage-sleep")"
    fi
    # SETTLE-LADDER mode (edge polling). When the account's own config dir holds
    # a `usage-seq` file — a comma-separated list of session percentages —
    # successive polls walk it and then hold at the last value: the shape a meter
    # that lags behind a landed turn and then stops moving actually has.
    #
    # Per CONFIG DIR, deliberately, not per env var: the daemon sets
    # CLAUDE_CONFIG_DIR per account exactly as a real turn spawn does, so two
    # tests running in one process cannot see each other's sequence, and the
    # machine-default account (no config dir) keeps the fixed reading.
    seqfile="${CLAUDE_CONFIG_DIR:-}/usage-seq"
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -f "$seqfile" ]]; then
      counter="${CLAUDE_CONFIG_DIR}/usage-seq.pos"
      n=0
      [[ -f "$counter" ]] && n="$(cat "$counter")"
      IFS=',' read -r -a seq <<< "$(cat "$seqfile")"
      last=$(( ${#seq[@]} - 1 ))
      idx=$n
      (( idx > last )) && idx=$last
      session="${seq[$idx]}"
      echo $(( n + 1 )) > "$counter"
      reset="$(date -v+2H '+%l:%M%p' 2>/dev/null || date -d '+2 hours' '+%l:%M%p')"
      reset="${reset# }"
      cat <<USAGE
{"type":"result","subtype":"success","is_error":false,"num_turns":0,"total_cost_usd":0,"result":"Current session: ${session}% used · resets ${reset} (America/Chicago)\nCurrent week (all models): 34% used · resets ${reset} (America/Chicago)\nCurrent week (Fable): 56% used · resets ${reset} (America/Chicago)","session_id":"fake-usage-sess"}
USAGE
      exit 0
    fi
    # The reset instants are computed ~2 hours ahead in LOCAL time rather than
    # hard-coded. Real claude reports a reset that is by definition inside the
    # pool it belongs to, and the calibrator now enforces exactly that (msg
    # #690: every execution in a window has to fall inside ONE session window,
    # and the session is placed as `resets_at - 5h`). A fixed calendar date
    # resolves to the NEXT occurrence \u2014 a year out once the date has passed \u2014
    # which no live session pool could ever report.
    reset="$(date -v+2H '+%l:%M%p' 2>/dev/null || date -d '+2 hours' '+%l:%M%p')"
    reset="${reset# }"
    # WEEKLY OVERRIDE (the 2026-08-14 shape). When the account's own config dir
    # holds a `usage-weekly` file, its contents are the "Current week (all
    # models)" percentage. Per config dir for the same reason as `usage-seq`:
    # two tests in one process must not be able to see each other's meter. This
    # is how a test makes the gauge report an EXHAUSTED account without a 429
    # anywhere in sight — which is precisely the fact the poller had and could
    # not act on.
    weekly=34
    wfile="${CLAUDE_CONFIG_DIR:-}/usage-weekly"
    if [[ -n "${CLAUDE_CONFIG_DIR:-}" && -f "$wfile" ]]; then
      weekly="$(cat "$wfile")"
    fi
    cat <<USAGE
{"type":"result","subtype":"success","is_error":false,"num_turns":0,"total_cost_usd":0,"result":"Current session: 12% used \u00b7 resets ${reset} (America/Chicago)\nCurrent week (all models): ${weekly}% used \u00b7 resets ${reset} (America/Chicago)\nCurrent week (Fable): 56% used \u00b7 resets ${reset} (America/Chicago)","session_id":"fake-usage-sess"}
USAGE
    exit 0
  fi
done

PROMPT="$(cat)"

# PROMPT CAPTURE (opt-in, additive — no existing branch changes behaviour).
# A prompt carrying `promptfile=<path>` gets written VERBATIM to that path,
# APPENDED with a NUL separator so several turns on one thread can each be
# inspected. This is the only way a test can assert on what the model actually
# received, which is the whole subject of the per-message metadata block.
if [[ "$PROMPT" == *"promptfile="* ]]; then
  CAPTURE="${PROMPT#*promptfile=}"
  CAPTURE="${CAPTURE%%[[:space:]]*}"
  if [[ -n "$CAPTURE" ]]; then
    printf '%s\0' "$PROMPT" >> "$CAPTURE"
  fi
fi

emit_init() {
  echo '{"type":"system","subtype":"init","session_id":"fake-sess","cwd":"/tmp","model":"claude-fable-5","tools":["Bash","Read"],"mcp_servers":[],"permissionMode":"bypassPermissions","slash_commands":["/usage"],"apiKeySource":"none","agents":[]}'
}
emit_text() {
  echo '{"type":"assistant","message":{"id":"msg_fake_01","model":"claude-fable-5","content":[{"type":"text","text":"Hello from fake claude."}],"usage":{"input_tokens":100,"output_tokens":20,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}'
}
emit_result() {
  echo '{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0.01,"num_turns":1,"duration_ms":50,"stop_reason":"end_turn","modelUsage":{"claude-fable-5":{"inputTokens":105,"outputTokens":25,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"costUSD":0.01}},"session_id":"fake-sess"}'
}

# ── STRUCTURED OUTPUT (R11.J4/J5): chosen by the SCHEMA, not the prompt ───────
#
# The corrective turn's prompt is written by the daemon, so a prompt keyword
# cannot steer it; the schema rides every turn of the question, so its
# `description` can. Additive: no turn without `--json-schema` reaches here.
SCHEMA=""
prev=""
for arg in "$@"; do
  [[ "$prev" == "--json-schema" ]] && SCHEMA="$arg"
  prev="$arg"
done
if [[ "$SCHEMA" == *"fake:"* ]]; then
  CORRECTIVE=0
  [[ "$PROMPT" == *"did not match the requested schema"* ]] && CORRECTIVE=1
  # `fake:fail` — the schema turn FAILS deterministically (the `badmodel`
  # shape: unclassified stderr, exit 1, no result line), so there is no answer
  # to judge. `fake:stall` — EVERY turn (not only the corrective one) waits on
  # `hold=<path>`: a schema turn definitely mid-flight, for a cancel (R11.J5).
  if [[ "$SCHEMA" == *"fake:fail"* ]]; then
    echo "Error: The model \"zzz-nonexistent\" is not a valid model" >&2
    exit 1
  fi
  if [[ ( $CORRECTIVE == 1 || "$SCHEMA" == *"fake:stall"* ) && "$SCHEMA" == *"hold="* ]]; then
    HOLD="${SCHEMA#*hold=}"
    HOLD="${HOLD%%[\" ]*}"
    for _ in $(seq 1 400); do [[ -f "$HOLD" ]] && break; sleep 0.05; done
  fi
  VALID=0
  if [[ "$SCHEMA" == *"fake:valid"* ]]; then VALID=1; fi
  if [[ "$SCHEMA" == *"fake:fix-on-retry"* && $CORRECTIVE == 1 ]]; then VALID=1; fi
  if [[ $VALID == 1 ]]; then VALUE='{"verdict":"merge"}'; else VALUE='{"verdict":"maybe"}'; fi
  echo '{"type":"system","subtype":"init","session_id":"fake-sess","cwd":"/tmp","model":"claude-fable-5","tools":["Bash","Read","StructuredOutput"],"mcp_servers":[],"permissionMode":"bypassPermissions","slash_commands":[],"apiKeySource":"none","agents":[]}'
  emit_text
  printf '{"type":"assistant","message":{"id":"msg_fake_so","model":"claude-fable-5","content":[{"type":"tool_use","id":"toolu_so1","name":"StructuredOutput","input":%s}],"usage":{"input_tokens":5,"output_tokens":5,"cache_read_input_tokens":0,"cache_creation_input_tokens":0}}}\n' "$VALUE"
  if [[ $VALID == 1 ]]; then
    echo '{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_so1","type":"tool_result","content":"Structured output provided successfully"}]}}'
    printf '{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0.01,"num_turns":2,"duration_ms":50,"stop_reason":"tool_use","result":%s,"structured_output":%s,"modelUsage":{},"session_id":"fake-sess"}\n' "$(printf '%s' "$VALUE" | sed 's/"/\\"/g; s/^/"/; s/$/"/')" "$VALUE"
  else
    echo '{"type":"user","message":{"role":"user","content":[{"type":"tool_result","content":"Output does not match required schema: /verdict: must be equal to one of the allowed values","is_error":true,"tool_use_id":"toolu_so1"}]}}'
    echo '{"type":"result","subtype":"success","is_error":false,"total_cost_usd":0.01,"num_turns":2,"duration_ms":50,"stop_reason":"end_turn","result":"Hello from fake claude.","modelUsage":{},"session_id":"fake-sess"}'
  fi
  exit 0
fi

# ── SUBAGENT USAGE LIMIT (the 2026-08-14 signal that was parsed and dropped) ──
#
# The parent turn is perfectly healthy and ENDS SUCCESSFULLY. That is the whole
# point: on 2026-08-14 six subagents died on the weekly limit between 19:33 and
# 19:36 while the parent kept streaming, and the parent's own 429 did not arrive
# until 19:39:37. A fixture whose parent also 429s could not tell the two fixes
# apart.
#
# The `system/task_updated` line is verbatim from the capture
# (`tests/fixtures/task_lifecycle.jsonl`), with the reset instant computed from
# today so the test is stable whenever it runs.
if [[ "$PROMPT" == *"limitsubagent"* ]]; then
  emit_init
  emit_text
  WHEN="$(date -v+2d '+%b %-d at 8pm (America/Chicago)' 2>/dev/null \
          || date -d '+2 days' '+%b %-d at 8pm (America/Chicago)')"
  printf '{"type":"system","subtype":"task_updated","task_id":"a47ddba3318c242f1","patch":{"status":"failed","end_time":1785622319569,"error":"Agent terminated early due to an API error: You'"'"'ve hit your weekly limit \u00b7 resets %s"},"uuid":"a6aa7cf5-0000-0000-0000-2cce961f1dc5","session_id":"fake-sess"}\n' "$WHEN"
  emit_result
  exit 0
# ── THE FALSE POSITIVE: a subagent that merely READ rate-limiting code ────────
#
# A terminal `failed` patch whose error text contains the bare word "resets",
# because the agent was quoting the crate's own source back at us. Routine work
# on this deployment. `classify_message`'s rate-limit branch matches exactly
# this substring, which is why the `TaskUpdated` arm must not use it: barring an
# account on this string would take a healthy login — and every label of it —
# out of service.
elif [[ "$PROMPT" == *"benignsubagent"* ]]; then
  emit_init
  emit_text
  printf '{"type":"system","subtype":"task_updated","task_id":"a47ddba3318c242f2","patch":{"status":"failed","end_time":1785622319569,"error":"Agent failed while reading retry.rs: the rate-limit branch matches the bare substring resets, see classify_message"},"uuid":"a6aa7cf5-0000-0000-0000-2cce961f1dc6","session_id":"fake-sess"}\n'
  emit_result
  exit 0
# ── A TURN THAT IS DEFINITELY MID-FLIGHT, WITH REAL WORK ON THE TRANSCRIPT ────
#
# For the mid-turn interrupt. Two properties the test needs and cannot fake from
# outside:
#
#   * it WRITES A TRANSCRIPT whose last record is an assistant turn, exactly as
#     real claude does, so the SIGKILL lands on a conversation that has landed
#     real work. `trimmable_tail` must refuse to roll that back, and `--resume`
#     must then replay it;
#   * the FIRST call blocks until it is killed; the SECOND call for the same
#     prompt (the retry) returns a normal successful turn — and REFUSES unless
#     it was invoked with `--resume`, so a test cannot pass by restarting fresh.
#
# The transcript path is derived exactly as `accounts::locate_transcript` scans
# for it: `<state_dir>/projects/<slug>/<session>.jsonl`.
elif [[ "$PROMPT" == *"midturnkill"* ]]; then
  TOKEN="$(printf '%s' "$PROMPT" | cksum | cut -d' ' -f1)"
  MARKER="$STATE_DIR/threads-mtk-$TOKEN"
  SESSION=""
  RESUMED=0
  prev=""
  for arg in "$@"; do
    case "$prev" in
      --session-id) SESSION="$arg" ;;
      --resume) SESSION="$arg"; RESUMED=1 ;;
    esac
    prev="$arg"
  done
  STATE="${CLAUDE_CONFIG_DIR:-${THREADS_CLAUDE_HOME:-$HOME}/.claude}"
  # SCAN for the session, exactly as `accounts::locate_transcript` does, so a
  # transcript the daemon PORTED to another account's store is still found. The
  # slug dir is only where it starts out.
  TX="$(find "$STATE/projects" -name "$SESSION.jsonl" -type f 2>/dev/null | head -1)"
  if [[ -z "$TX" ]]; then
    TDIR="$STATE/projects/-fake-slug"
    mkdir -p "$TDIR"
    TX="$TDIR/$SESSION.jsonl"
  fi
  if [[ ! -f "$MARKER" ]]; then
    : > "$MARKER"
    emit_init
    # The conversation, as claude writes it: the prompt, then a REAL assistant
    # record. This is the tail `trimmable_tail` must refuse to trim.
    {
      echo '{"type":"user","message":{"role":"user","content":"midturnkill"},"uuid":"tx-user-1"}'
      echo '{"type":"assistant","message":{"role":"assistant","model":"claude-fable-5","content":[{"type":"text","text":"half a thought"}]},"uuid":"tx-asst-1"}'
    } >> "$TX"
    emit_text
    # Long enough that only a teardown ends it.
    sleep 30
    emit_result
    exit 0
  fi
  if [[ "$RESUMED" != "1" ]]; then
    echo "fake-claude: the retry did NOT resume — a mid-turn interrupt must not restart fresh" >&2
    exit 1
  fi
  if [[ ! -f "$TX" ]]; then
    echo "fake-claude: --resume $SESSION but no transcript at $TX" >&2
    exit 1
  fi
  if ! tail -1 "$TX" | grep -q '"type":"assistant"'; then
    echo "fake-claude: the transcript's last record is not the mid-stream assistant turn" >&2
    exit 1
  fi
  emit_init; emit_text; emit_result; exit 0
# ── A PROJECTED TURN (R4.S4a, `tests/projected_turn.rs`) ─────────────────────
#
# The daemon RENDERED the transcript from its ledger before spawning us, so we
# behave as real claude does on `--resume`: find the file by scanning
# `<state>/projects/*/<session>.jsonl` (exactly `accounts::locate_transcript`),
# then APPEND what the wire never carries — the prompt as delivered under our
# own uuid, an `attachment`, an `isMeta` line — and the assistant record, whose
# uuid is the same one we print on stdout. On `--session-id` (no file rendered,
# the thread is new) the file is created where real claude files it: under the
# slug of the cwd. Written with python3 because the prompt holds the daemon's
# metadata block, quotes included, and bash cannot JSON-escape it.
elif [[ "$PROMPT" == *"projected"* ]]; then
  SESSION=""
  RESUMED=0
  prev=""
  for arg in "$@"; do
    case "$prev" in
      --session-id) SESSION="$arg" ;;
      --resume) SESSION="$arg"; RESUMED=1 ;;
    esac
    prev="$arg"
  done
  STATE="${CLAUDE_CONFIG_DIR:-${THREADS_CLAUDE_HOME:-$HOME}/.claude}"
  TX="$(find "$STATE/projects" -name "$SESSION.jsonl" -type f 2>/dev/null | head -1)"
  if [[ -z "$TX" ]]; then
    if [[ "$RESUMED" == "1" ]]; then
      echo "fake-claude: --resume $SESSION but no transcript under $STATE/projects" >&2
      exit 1
    fi
    SLUG="$(printf '%s' "$PWD" | sed 's/[^a-zA-Z0-9]/-/g')"
    mkdir -p "$STATE/projects/$SLUG"
    TX="$STATE/projects/$SLUG/$SESSION.jsonl"
    : > "$TX"
  elif [[ "$RESUMED" != "1" ]]; then
    echo "fake-claude: --session-id $SESSION but a transcript already exists at $TX" >&2
    exit 1
  fi
  emit_init
  # MID-TURN HOLD (R4.S4a-land): with `release=<path>` in the prompt the turn
  # stays open after `init` until the test creates that file (20s ceiling),
  # so another writer can touch the thread's ledger while this turn holds it.
  # Additive: a projected prompt without `release=` is unchanged.
  if [[ "$PROMPT" == *"release="* ]]; then
    REL="${PROMPT#*release=}"
    REL="${REL%%[[:space:]]*}"
    for _ in $(seq 1 1000); do
      [[ -n "$REL" && -f "$REL" ]] && break
      sleep 0.02
    done
  fi
  FAKE_TX="$TX" FAKE_SESSION="$SESSION" FAKE_PROMPT="$PROMPT" FAKE_CWD="$PWD" python3 - <<'PY'
import json, os, uuid, datetime
tx, session, prompt, cwd = os.environ["FAKE_TX"], os.environ["FAKE_SESSION"], os.environ["FAKE_PROMPT"], os.environ["FAKE_CWD"]
lines = [l for l in open(tx).read().split("\n") if l.strip()]
parent = None
n = 0
for l in lines:
    try:
        v = json.loads(l)
    except Exception:
        continue
    if v.get("uuid"):
        parent = v["uuid"]
    if v.get("type") == "assistant":
        n += 1
def ts():
    return datetime.datetime.utcnow().strftime("%Y-%m-%dT%H:%M:%S.%f")[:-3] + "Z"
def stamp(d, parent):
    d.update({"parentUuid": parent, "isSidechain": False, "userType": "external", "cwd": cwd,
              "sessionId": session, "version": "2.1.280-fake", "gitBranch": None, "timestamp": ts()})
    return d
out = []
u_prompt = str(uuid.uuid4())
out.append(stamp({"type": "user", "uuid": u_prompt, "message": {"role": "user", "content": prompt}}, parent))
# The attachment hangs BESIDE the prompt as a side child (a branch point in
# the real file — `thread-adapters.md` §2.2); the conversation chain runs
# prompt → meta → assistant.
u_att = str(uuid.uuid4())
out.append(stamp({"type": "attachment", "uuid": u_att, "attachment": {"type": "environment", "text": "fake environment"}}, u_prompt))
u_meta = str(uuid.uuid4())
out.append(stamp({"type": "user", "uuid": u_meta, "isMeta": True, "message": {"role": "user", "content": [{"type": "text", "text": "fake skill listing"}]}}, u_prompt))
u_asst = str(uuid.uuid4())
msg = {"id": "msg_fake_proj_%d" % (n + 1), "model": "claude-fable-5", "role": "assistant",
       "content": [{"type": "text", "text": "projected reply %d" % (n + 1)}],
       "usage": {"input_tokens": 100, "output_tokens": 20, "cache_read_input_tokens": 0, "cache_creation_input_tokens": 0}}
asst = stamp({"type": "assistant", "uuid": u_asst, "requestId": "req_fake_%d" % (n + 1), "message": msg}, u_meta)
out.append(asst)
with open(tx, "a") as f:
    for d in out:
        f.write(json.dumps(d, separators=(",", ":")) + "\n")
# The wire line for the same assistant record, in the wire's spelling.
wire = {"type": "assistant", "uuid": u_asst, "session_id": session, "request_id": asst["requestId"],
        "timestamp": asst["timestamp"], "parent_tool_use_id": None, "message": msg}
print(json.dumps(wire, separators=(",", ":")))
PY
